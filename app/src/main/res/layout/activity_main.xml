<?xml version="1.0" encoding="utf-8"?>
<!-- KeyButtons carry their TV key name in android:tag; MainActivity wires them up generically. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <!-- Header: connection chip + advanced menu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.massliharf.tvremote.KeyButton
                android:id="@+id/statusChip"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                app:kbAlignStart="true"
                app:kbIcon="@drawable/ic_tv"
                app:kbIconSize="22dp"
                app:kbShape="pill"
                app:kbText="Bağlı değil"
                app:kbTextSize="15sp" />

            <com.massliharf.tvremote.KeyButton
                android:id="@+id/btnMore"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="10dp"
                android:contentDescription="Gelişmiş"
                app:kbIcon="@drawable/ic_more"
                app:kbShape="circle" />
        </LinearLayout>

        <!-- Quick switcher between saved devices (shown when there are two or more) -->
        <HorizontalScrollView
            android:id="@+id/deviceBarScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/deviceBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- Remote body -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/body_bg"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="22dp"
            android:paddingEnd="22dp"
            android:paddingBottom="30dp">

            <!-- Power / input / settings -->
            <LinearLayout style="@style/Row" android:gravity="center_vertical">
                <com.massliharf.tvremote.KeyButton
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:contentDescription="Güç"
                    android:tag="POWER"
                    app:kbIcon="@drawable/ic_power"
                    app:kbIconSize="28dp"
                    app:kbKind="red"
                    app:kbShape="circle" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <com.massliharf.tvremote.KeyButton
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:contentDescription="Kaynak"
                    android:tag="INPUT"
                    app:kbIcon="@drawable/ic_input"
                    app:kbShape="circle" />

                <com.massliharf.tvremote.KeyButton
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="12dp"
                    android:contentDescription="Ayarlar"
                    android:tag="MENU"
                    app:kbIcon="@drawable/ic_settings"
                    app:kbShape="circle" />
            </LinearLayout>

            <!-- Navigation: D-pad, or touchpad when toggled -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="264dp"
                android:layout_marginTop="20dp">

                <com.massliharf.tvremote.DpadView
                    android:id="@+id/dpad"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <com.massliharf.tvremote.TouchpadView
                    android:id="@+id/touchpad"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Back / home / mute -->
            <LinearLayout
                style="@style/Row"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical">

                <com.massliharf.tvremote.KeyButton
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:contentDescription="Geri"
                    android:tag="BACK"
                    app:kbIcon="@drawable/ic_back" />

                <com.massliharf.tvremote.KeyButton
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1.3"
                    android:contentDescription="Ana sayfa"
                    android:tag="HOME"
                    app:kbIcon="@drawable/ic_home"
                    app:kbIconSize="28dp"
                    app:kbKind="blue" />

                <com.massliharf.tvremote.KeyButton
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:contentDescription="Sessiz"
                    android:tag="MUTE"
                    app:kbIcon="@drawable/ic_mute" />
            </LinearLayout>

            <!-- Volume rocker + shortcuts -->
            <LinearLayout
                style="@style/Row"
                android:layout_marginTop="18dp">

                <com.massliharf.tvremote.RockerView
                    android:id="@+id/volRocker"
                    android:layout_width="76dp"
                    android:layout_height="196dp"
                    app:rkBottomKey="VOLUMEDOWN"
                    app:rkLabel="SES"
                    app:rkTopKey="VOLUMEUP" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="196dp"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                        <com.massliharf.tvremote.KeyButton
                            android:id="@+id/btnApps"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            app:kbIcon="@drawable/ic_apps"
                            app:kbKind="purple"
                            app:kbText="Uygulama"
                            app:kbTextSize="12sp"
                            app:kbVertical="true" />

                        <com.massliharf.tvremote.KeyButton
                            android:id="@+id/btnKeyboard"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            app:kbIcon="@drawable/ic_keyboard"
                            app:kbKind="orange"
                            app:kbText="Klavye"
                            app:kbTextSize="12sp"
                            app:kbVertical="true" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="10dp"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                        <com.massliharf.tvremote.KeyButton
                            android:id="@+id/btnPad"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            app:kbIcon="@drawable/ic_touch"
                            app:kbKind="yellow"
                            app:kbText="Touchpad"
                            app:kbTextSize="12sp"
                            app:kbVertical="true" />

                        <com.massliharf.tvremote.KeyButton
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:contentDescription="Oynat / duraklat"
                            android:tag="PLAYPAUSE"
                            app:kbIcon="@drawable/ic_playpause"
                            app:kbIconSize="32dp"
                            app:kbKind="green"
                            app:kbText="Oynat"
                            app:kbTextSize="12sp"
                            app:kbVertical="true" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/modeHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="LG webOS"
            android:textColor="@color/muted"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
