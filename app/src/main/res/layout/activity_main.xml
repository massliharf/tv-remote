<?xml version="1.0" encoding="utf-8"?>
<!-- Buttons carry their key name in android:tag; MainActivity wires them up generically. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- Status bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp">

        <View
            android:id="@+id/statusDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/round_bg" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Bağlı değil"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnIr"
            style="@style/Key"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_weight="0"
            android:minWidth="64dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="IR"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnConnect"
            style="@style/Key"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_weight="0"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Bağlan"
            android:textSize="13sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="16dp">

            <!-- Power / input / settings -->
            <LinearLayout style="@style/Row">
                <Button
                    style="@style/Key"
                    android:background="@drawable/power_bg"
                    android:tag="POWER"
                    android:text="⏻ Güç" />
                <Button style="@style/Key" android:tag="INPUT" android:text="Kaynak" />
                <Button style="@style/Key" android:tag="MENU" android:text="Ayarlar" />
                <Button style="@style/Key" android:tag="QMENU" android:text="Q.Menü" />
            </LinearLayout>

            <!-- D-pad -->
            <FrameLayout
                android:id="@+id/dpadArea"
                android:layout_width="match_parent"
                android:layout_height="236dp"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="236dp"
                    android:layout_height="236dp"
                    android:layout_gravity="center"
                    android:orientation="vertical">

                    <LinearLayout style="@style/Row" android:layout_height="0dp" android:layout_weight="1">
                        <Space android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                        <Button style="@style/Key" android:layout_height="match_parent" android:background="@drawable/round_bg" android:tag="UP" android:text="▲" />
                        <Space android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                    </LinearLayout>

                    <LinearLayout style="@style/Row" android:layout_height="0dp" android:layout_weight="1">
                        <Button style="@style/Key" android:layout_height="match_parent" android:background="@drawable/round_bg" android:tag="LEFT" android:text="◀" />
                        <Button style="@style/Key" android:layout_height="match_parent" android:background="@drawable/ok_bg" android:tag="ENTER" android:text="OK" android:textStyle="bold" />
                        <Button style="@style/Key" android:layout_height="match_parent" android:background="@drawable/round_bg" android:tag="RIGHT" android:text="▶" />
                    </LinearLayout>

                    <LinearLayout style="@style/Row" android:layout_height="0dp" android:layout_weight="1">
                        <Space android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                        <Button style="@style/Key" android:layout_height="match_parent" android:background="@drawable/round_bg" android:tag="DOWN" android:text="▼" />
                        <Space android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- Touchpad (Magic Remote style pointer); hidden until toggled -->
            <com.massliharf.tvremote.TouchpadView
                android:id="@+id/touchpad"
                android:layout_width="match_parent"
                android:layout_height="236dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/pad_bg"
                android:visibility="gone" />

            <LinearLayout style="@style/Row">
                <Button style="@style/Key" android:tag="BACK" android:text="↩ Geri" />
                <Button style="@style/Key" android:tag="HOME" android:text="⌂ Ana Sayfa" />
                <Button style="@style/Key" android:tag="EXIT" android:text="Çıkış" />
            </LinearLayout>

            <!-- Volume / mute / channel -->
            <LinearLayout style="@style/Row" android:layout_marginTop="4dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <Button style="@style/Key" android:layout_width="match_parent" android:layout_weight="0" android:tag="VOLUMEUP" android:text="Ses +" />
                    <Button style="@style/Key" android:layout_width="match_parent" android:layout_weight="0" android:tag="VOLUMEDOWN" android:text="Ses −" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <Button style="@style/Key" android:layout_width="match_parent" android:layout_weight="0" android:tag="MUTE" android:text="🔇 Sessiz" />
                    <Button style="@style/Key" android:layout_width="match_parent" android:layout_weight="0" android:tag="INFO" android:text="Bilgi" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <Button style="@style/Key" android:layout_width="match_parent" android:layout_weight="0" android:tag="CHANNELUP" android:text="Kanal +" />
                    <Button style="@style/Key" android:layout_width="match_parent" android:layout_weight="0" android:tag="CHANNELDOWN" android:text="Kanal −" />
                </LinearLayout>
            </LinearLayout>

            <!-- Tools -->
            <LinearLayout style="@style/Row" android:layout_marginTop="4dp">
                <Button android:id="@+id/btnPad" style="@style/Key" android:text="Touchpad" />
                <Button android:id="@+id/btnKeyboard" style="@style/Key" android:text="Klavye" />
                <Button android:id="@+id/btnApps" style="@style/Key" android:text="Uygulamalar" />
                <Button android:id="@+id/btnNumbers" style="@style/Key" android:text="123" />
            </LinearLayout>

            <!-- Number pad; hidden until toggled -->
            <LinearLayout
                android:id="@+id/numpad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <LinearLayout style="@style/Row">
                    <Button style="@style/Key" android:tag="1" android:text="1" />
                    <Button style="@style/Key" android:tag="2" android:text="2" />
                    <Button style="@style/Key" android:tag="3" android:text="3" />
                </LinearLayout>
                <LinearLayout style="@style/Row">
                    <Button style="@style/Key" android:tag="4" android:text="4" />
                    <Button style="@style/Key" android:tag="5" android:text="5" />
                    <Button style="@style/Key" android:tag="6" android:text="6" />
                </LinearLayout>
                <LinearLayout style="@style/Row">
                    <Button style="@style/Key" android:tag="7" android:text="7" />
                    <Button style="@style/Key" android:tag="8" android:text="8" />
                    <Button style="@style/Key" android:tag="9" android:text="9" />
                </LinearLayout>
                <LinearLayout style="@style/Row">
                    <Button style="@style/Key" android:tag="GUIDE" android:text="Rehber" />
                    <Button style="@style/Key" android:tag="0" android:text="0" />
                    <Button style="@style/Key" android:tag="ENTER" android:text="OK" />
                </LinearLayout>
            </LinearLayout>

            <!-- Media -->
            <LinearLayout style="@style/Row" android:layout_marginTop="4dp">
                <Button style="@style/Key" android:tag="REWIND" android:text="⏪" />
                <Button style="@style/Key" android:tag="PLAY" android:text="▶" />
                <Button style="@style/Key" android:tag="PAUSE" android:text="⏸" />
                <Button style="@style/Key" android:tag="STOP" android:text="⏹" />
                <Button style="@style/Key" android:tag="FASTFORWARD" android:text="⏩" />
            </LinearLayout>

            <!-- Color keys -->
            <LinearLayout style="@style/Row">
                <Button style="@style/Key" android:layout_height="36dp" android:backgroundTint="#FFDC2626" android:tag="RED" />
                <Button style="@style/Key" android:layout_height="36dp" android:backgroundTint="#FF16A34A" android:tag="GREEN" />
                <Button style="@style/Key" android:layout_height="36dp" android:backgroundTint="#FFEAB308" android:tag="YELLOW" />
                <Button style="@style/Key" android:layout_height="36dp" android:backgroundTint="#FF2563EB" android:tag="BLUE" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
