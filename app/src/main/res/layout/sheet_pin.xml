<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <ImageView
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginBottom="10dp"
        android:src="@drawable/ic_android"
        android:tint="@color/green" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:text="Cihazın ekranında 6 haneli bir kod çıktı. Kodu aşağıya yazın."
        android:textColor="@color/text"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/pinField"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_margin="5dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/field_bg"
        android:gravity="center"
        android:hint="A1B2C3"
        android:imeOptions="actionDone"
        android:inputType="textCapCharacters|textNoSuggestions|textVisiblePassword"
        android:letterSpacing="0.3"
        android:maxLength="6"
        android:textColor="@color/text"
        android:textColorHint="@color/muted"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/pinError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="4dp"
        android:textColor="@color/red"
        android:textSize="14sp"
        android:visibility="gone" />

    <com.massliharf.tvremote.KeyButton
        android:id="@+id/btnPin"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_margin="5dp"
        android:layout_marginTop="10dp"
        app:kbKind="green"
        app:kbText="Eşleştir" />
</LinearLayout>
