<?xml version="1.0" encoding="utf-8"?>
<!-- Remote body: a bordered card with a thicker bottom "lip", Duolingo style. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/body_border" />
            <corners android:radius="44dp" />
        </shape>
    </item>
    <item android:bottom="6dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/body_face" />
            <stroke android:width="2dp" android:color="@color/body_border" />
            <corners android:radius="44dp" />
        </shape>
    </item>
</layer-list>
